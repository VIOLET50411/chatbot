# Soul Mate 当前生产架构：Docker 核心 + Windows wxautox4 Plus 薄代理
# 复制为 .env 后填写真实值；所有文件保持 UTF-8，不要提交 .env。

# ── DeepSeek 两阶段对话 ───────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_PLANNER_TEMPERATURE=0.2
DEEPSEEK_RENDER_TEMPERATURE=0.85

# ── Docker 内本地中文向量 ─────────────────────────────────────────
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_ALLOW_HASH_FALLBACK=true

# ── Owner 管理台 ──────────────────────────────────────────────────
ADMIN_USERNAME=admin
# 兼容自举；稳定运行后建议改用 OWNER_PASSWORD_HASH。
ADMIN_PASSWORD=123456
SOUL_MATE_BIND_ADDRESS=0.0.0.0
OWNER_PASSWORD_HASH=
OWNER_ID=owner
OWNER_SESSION_TTL_SECONDS=14400

# PWA 独立入口口令；不要与管理台密码相同。
PWA_CHAT_TOKEN=

# ── Windows Plus 桥接 ──────────────────────────────────────────────
# 使用独立的高强度随机值，至少 24 个字符。
WECHAT_BRIDGE_TOKEN=
WECHAT_BRIDGE_BASE_URL=http://127.0.0.1:8080
WECHAT_BRIDGE_ALLOW_REMOTE=false
WECHAT_BRIDGE_AGENT_ID=windows-wechat-primary
WECHAT_BRIDGE_STATE_DIR=./host-data
WECHAT_CLIENT_VERSION=
BRIDGE_ATTACHMENT_MAX_BYTES=20971520
# 仅在管理台目录不可用且显式打开灾难恢复开关时使用；nickname 必须精确一致。
# 不允许省略窗口昵称，也不会回退到任意微信窗口。
WECHAT_ACCOUNTS_JSON=[{"account_id":"du-jiaying","nickname":"Sakino"},{"account_id":"ji-yu","nickname":"Locin"}]
WECHAT_ACCOUNT_CONFIG_FALLBACK=false
ADMIN_DEFAULT_CHARACTER_ID=ji-yu

# 自定义表情入站截图；选择器连续失败三次后只熔断此功能。
WECHAT_STICKER_CAPTURE_ENABLED=true
# 收藏表情原生发送必须锁定微信版本、窗口位置和 DPI；留空即关闭。
WECHAT_FAVORITES_BUTTON_XY=
WECHAT_FAVORITES_PANEL_BBOX=
WECHAT_FAVORITES_GRID=5,4
WECHAT_FAVORITES_HASH_DISTANCE=6

# ── 图片理解 ──────────────────────────────────────────────────────
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.7-flash
VISION_MAX_IMAGE_BYTES=20971520
AUDIO_API_KEY=
AUDIO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AUDIO_MODEL=qwen3-asr-flash
# 管理台密钥加密主密钥；本地可留空沿用桥接 Token，VPS 建议设置独立随机长密钥。
RUNTIME_SETTINGS_MASTER_KEY=

# ── 回复、聚合和主动联系策略 ──────────────────────────────────────
INBOUND_AGGREGATION_MIN_SECONDS=4
INBOUND_AGGREGATION_MAX_SECONDS=8
SOUL_MATE_MAX_REPLY_DELAY_SECONDS=90
PROACTIVE_MAX_DAILY=4
PROACTIVE_ACTIVE_START_HOUR=8
PROACTIVE_ACTIVE_END_HOUR=24
PROACTIVE_CHECK_IN_AFTER_HOURS=8
PROACTIVE_COOLDOWN_HOURS=4

# 真实朋友圈自主发布必须先完成测试标签验收；当前核心默认不自动生成或发布。
MOMENTS_AUTONOMOUS_ENABLED=false
MOMENTS_PRIVACY_TAGS=

# ── 只读外界信息（共享缓存，不写入人物快照或联系人记忆）────────────
# JSON 数组示例：[{"name":"某资讯源","url":"https://example.com/feed.xml"}]
EXTERNAL_RSS_FEEDS_JSON=[]
EXTERNAL_REFRESH_MINUTES=30
# X API 当前按量计费；仅在同时填写 Token 与公开账号名时调用。
X_BEARER_TOKEN=
X_FOLLOW_USERNAMES=

# 可选：宿主机常驻 Chrome + ai-social-browser 动作服务。核心只允许读取，不允许点赞、回复或发布。
SOCIAL_BROWSER_PROXY_URL=http://host.docker.internal:8280
SOCIAL_BROWSER_PROXY_TOKEN=
SOCIAL_BROWSER_X_ENABLED=false
SOCIAL_BROWSER_XHS_ENABLED=false
SOCIAL_BROWSER_X_UPSTREAM=http://127.0.0.1:8272/twitter
SOCIAL_BROWSER_XHS_UPSTREAM=http://127.0.0.1:8273/xiaohongshu

# ── 数据与日志 ────────────────────────────────────────────────────
DATA_DIR=./data
CHARACTER_REGISTRY_DIR=./data/registry
LOG_LEVEL=INFO
APSCHEDULER_EXECUTOR_LOG_LEVEL=WARNING
OPS_WEBHOOK_URL=
